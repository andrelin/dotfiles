[core]
  editor = vim
  excludesfile = ~/.gitignore_global
  precomposeunicode = true
  filemode = false
  longpaths = true
  autocrlf = input

[help]
  autocorrect = 1

[apply]
  whitespace = strip

[color]
  branch = auto
  diff = auto
  status = auto
  ui = auto

[push]
  default = tracking

[pull]
  rebase = true

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[user]
  name = Andreas Lind-Johansen
  email = andreas@lindjo.no

[include]
  path = ~/.gitconfig_credentials


# Uptime's repos commit as the company address wherever they are cloned: its GitHub org here (URL matching is
# case-sensitive, hence both spellings), its own Forgejo in ~/.gitconfig_credentials, which may name its hosts;
# the gitdir line covers a repo under ~/src/uptime with no remote yet.
[includeIf "hasconfig:remote.*.url:git@github.com:uptimeconsulting/**"]
  path = ~/.gitconfig_uptime
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/uptimeconsulting/**"]
  path = ~/.gitconfig_uptime
[includeIf "hasconfig:remote.*.url:https://github.com/uptimeconsulting/**"]
  path = ~/.gitconfig_uptime
[includeIf "hasconfig:remote.*.url:git@github.com:UptimeConsulting/**"]
  path = ~/.gitconfig_uptime
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/UptimeConsulting/**"]
  path = ~/.gitconfig_uptime
[includeIf "hasconfig:remote.*.url:https://github.com/UptimeConsulting/**"]
  path = ~/.gitconfig_uptime
[includeIf "gitdir:~/src/uptime/"]
  path = ~/.gitconfig_uptime
