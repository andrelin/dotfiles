#!/usr/bin/env bash
#
# Merge the dotfiles-owned entries into a machine-local Claude Code settings.json, leaving everything else as is.
#
# Usage: claude-settings-merge hooks|hardening|allows <settings-file>
#   hooks      Register ~/.claude/hooks/work-context.sh for PreToolUse and SessionStart, and
#              ~/.claude/hooks/watch-main-ci.sh for PostToolUse.
#   hardening  Add the credential, rc-file, marker and customers-file deny rules, and load AGENTS.md beside CLAUDE.md.
#              The checkout's link/.ssh/keys rule is expanded from $DOTFILES, written ~/-relative when that is under
#              $HOME, replaces any earlier such rule, and is skipped when $DOTFILES is unset.
#   allows     Add the allow rules for cleaning up after a merge: removing a worktree, deleting a branch locally and
#              on origin. work-context.sh still blocks the push where the remote is the user's (customer).
#
# Exit 0 on success; 1 when jq is missing, a hook script is missing (hooks only) or the file isn't valid JSON,
# with the file untouched; 2 on bad usage.

set -euo pipefail

function usage() {
  echo "Usage: $(basename "$0") hooks|hardening|allows <settings-file>" >&2
  exit 2
}

# Owned entries are found by their command, then removed and re-appended on every run, so a change to the
# canonical entry reaches machines that already ran this. A foreign hook sharing a group with ours stays.
# shellcheck disable=SC2016 # $vars are jq's, not the shell's
hooks_filter='
  def owned: (.command // "") | (contains("work-context.sh") or contains("watch-main-ci.sh"));
  def merge(event; entry):
    .hooks[event] = ([(.hooks[event] // [])[]
      | .hooks = [(.hooks // [])[] | select(owned | not)]
      | select(.hooks | length > 0)] + [entry]);
  merge("PreToolUse"; {
    matcher: "Bash|Monitor|Read|Grep|Write|Edit|MultiEdit|NotebookEdit",
    hooks: [{type: "command", command: "/bin/bash ~/.claude/hooks/work-context.sh pre-tool-use",
             timeout: 10, onFailure: "block"}]
  })
  | merge("SessionStart"; {
    hooks: [{type: "command", command: "/bin/bash ~/.claude/hooks/work-context.sh session-start", timeout: 10}]
  })
  | merge("PostToolUse"; {
    matcher: "Bash",
    hooks: [{type: "command", command: "/bin/bash ~/.claude/hooks/watch-main-ci.sh", timeout: 10}]
  })
'

# unique also sorts, so the deny list stays in the order bin/sort-claude-settings would give it.
# The marker rules are anchored at ~/ because the marker sits above the repo, beyond a bare or **/ path's reach.
# instructionFiles is set only when unset, so a deliberate local choice survives.
# A deny rule may not follow the ~/.ssh link into the checkout, so its keys get their own rule. It is ~/-relative
# when it can be, so no username lands in it; otherwise // anchors it at the filesystem root, where a single /
# would be relative to the settings file. Any earlier checkout rule is dropped first, so a moved checkout or a
# renamed user leaves none behind; with no new rule to write, the old one stays rather than leave the keys open.
# shellcheck disable=SC2016 # $extra is jq's, not the shell's
hardening_filter='
  def checkout_keys: test("^Read\\(.*/link/\\.ssh/keys/\\*\\*\\)$");
  .permissions.deny = ((((.permissions.deny // [])
    | if ($extra | length) > 0 then map(select(checkout_keys | not)) else . end) + [
    "Read(~/.ssh/id_*)", "Read(~/.ssh/keys/**)", "Read(~/.aws/credentials)", "Read(~/.kube/config)",
    "Read(~/.git-credentials)", "Read(~/.gitconfig_credentials)", "Read(~/.gnupg/**)", "Read(~/.config/gh/hosts.yml)",
    "Read(~/.ssh/config_private)", "Read(~/.ssh/allowed_signers)",
    "Edit(~/.zshrc)", "Edit(~/.bashrc)", "Edit(~/.bash_profile)", "Edit(~/.zprofile)", "Edit(~/.profile)",
    "Edit(~/**/.claude-files-issues)", "Bash(touch *.claude-files-issues*)", "Edit(~/.claude-customers)"
  ] + $extra) | unique)
  | .pluginConfigs["cc-plugin-agents-md@builtin"].options.instructionFiles //= "claude-md-and-agents-md"
'

# Without these the auto-mode classifier blocks the clean-up as destructive, wherever the session started.
allows_filter='
  .permissions.allow = (((.permissions.allow // []) + [
    "Bash(git worktree remove *)", "Bash(git branch -D *)", "Bash(git push origin --delete *)"
  ]) | unique)
'

[[ $# -eq 2 ]] || usage
settings="$2"
case "$1" in
  hooks) filter="$hooks_filter" ;;
  hardening) filter="$hardening_filter" ;;
  allows) filter="$allows_filter" ;;
  *) usage ;;
esac

# A hook pointing at nothing either blocks every tool call (onFailure: block) or silently guards nothing.
# hardening registers no hook, so it doesn't need the scripts.
if [[ "$1" == hooks ]]; then
  for script in work-context.sh watch-main-ci.sh; do
    if [[ ! -r "$HOME/.claude/hooks/$script" ]]; then
      echo "$HOME/.claude/hooks/$script not found; run dotfiles first. $settings left untouched." >&2
      exit 1
    fi
  done
fi

if ! type -P jq >/dev/null; then
  echo "jq not found; $settings left untouched." >&2
  exit 1
fi

extra='[]'
if [[ "$1" == hardening ]]; then
  if [[ -n "${DOTFILES:-}" ]]; then
    checkout="${DOTFILES%/}"
    if [[ "$checkout" == "${HOME%/}/"* ]]; then
      # shellcheck disable=SC2088 # a literal ~/ is the point: Claude Code expands it, not the shell
      checkout='~/'"${checkout#"${HOME%/}/"}"
    else
      checkout="/$checkout"
    fi
    extra="$(jq -cn --arg r "Read($checkout/link/.ssh/keys/**)" '[$r]')"
  else
    echo "DOTFILES is not set; skipping the deny rule for the checkout's link/.ssh/keys." >&2
  fi
fi

[[ -s "$settings" ]] || echo '{}' > "$settings"

if jq --argjson extra "$extra" "$filter" "$settings" > "$settings.tmp"; then
  mv "$settings.tmp" "$settings"
else
  rm -f "$settings.tmp"
  echo "Couldn't update $settings; is it valid JSON?" >&2
  exit 1
fi
