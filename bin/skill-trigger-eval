#!/usr/bin/env bash
#
# Score how often a skill's description triggers on its eval set, with skill-creator's run_eval.
#
# Usage: skill-trigger-eval <skill> [--description <text>] [--model <alias>]
#   The eval set is test/skill-triggers/<skill>.json: [{"id": "1.n", "query": "...", "should_trigger": true|false}, ...].
#   --description  score this candidate instead of the skill's current description, without editing the file.
#   --model        the model for every run; default the one bin/ai uses for a stage skill, else opus.
#
# The installed copy of the skill is moved out of the skills dir for the run, since it outcompetes the candidate
# run_eval installs as a command, so the skill is unavailable to every session on the machine until it finishes.
#
# Exit 0 with run_eval's JSON on stdout; 1 with nothing on stdout when a prerequisite is missing, run_eval fails, or
# any claude run failed rather than being decided; 2 on bad usage.
#
# Env: SKILL_TRIGGER_EVAL_PYTHON (the only python tried), SKILL_TRIGGER_EVAL_SKILLS_DIR (default claude/skills).

set -euo pipefail

function usage() {
  echo "Usage: $(basename "$0") <skill> [--description <text>] [--model <alias>]" >&2
  exit 2
}

function die() {
  echo "$(basename "$0"): $*" >&2
  exit 1
}

[[ $# -ge 1 && "$1" != -* ]] || usage
skill="$1"
shift
description=""
model=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --description) [[ $# -ge 2 ]] || usage; description="$2"; shift 2 ;;
    --model) [[ $# -ge 2 ]] || usage; model="$2"; shift 2 ;;
    *) usage ;;
  esac
done

: "${DOTFILES:?DOTFILES is not set}"
skills_dir="${SKILL_TRIGGER_EVAL_SKILLS_DIR:-$DOTFILES/claude/skills}"
skill_dir="$skills_dir/$skill"
eval_set="$DOTFILES/test/skill-triggers/$skill.json"
marker="$DOTFILES/caches/.skill-trigger-eval-moved"

[[ -f "$skill_dir/SKILL.md" ]] || die "no skill at $skill_dir"
[[ -f "$eval_set" ]] || die "no eval set at $eval_set"
if [[ -e "$marker" ]]; then
  die "an earlier run left a skill moved out ($(cat "$marker")); put it back and delete $marker"
fi

plugin="$(jq -r '.plugins["skill-creator@claude-plugins-official"][0].installPath // empty' \
  "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null || true)"
creator="$plugin/skills/skill-creator"
[[ -n "$plugin" && -f "$creator/scripts/run_eval.py" ]] ||
  die "skill-creator plugin not installed; run init/53_claude_plugins.sh"

# run_eval's annotations need 3.10, which macOS's /usr/bin/python3 and RHEL 9's are not.
python=""
if [[ -n "${SKILL_TRIGGER_EVAL_PYTHON:-}" ]]; then
  candidates=("$SKILL_TRIGGER_EVAL_PYTHON")
else
  mapfile -t candidates < <(type -ap python3)
fi
for p in "${candidates[@]}"; do
  if "$p" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    python="$p"
    break
  fi
done
[[ -n "$python" ]] || die "no python3 of 3.10 or later found"

real_claude="$(type -P claude || true)"
[[ -n "$real_claude" ]] || die "claude not found on PATH"
# kill_tree finds a run's tool shells with it, and without it would leave them running.
type -P pgrep > /dev/null || die "pgrep not found on PATH (procps-ng on RHEL)"

# The stage skills run on the model bin/ai gives their stage, so they are scored on it.
if [[ -z "$model" ]]; then
  case "$skill" in
    writing-issues) model="${AI_MODEL_ISSUE:-sonnet}" ;;
    writing-plans) model="${AI_MODEL_PLAN:-opus}" ;;
    implementing-plans) model="${AI_MODEL_IMPLEMENT:-sonnet}" ;;
    reviewing-in-rounds) model="${AI_MODEL_REVIEW:-opus}" ;;
    *) model=opus ;;
  esac
fi

# run_eval writes its command file under the nearest .claude/ above its cwd, so it runs in a temp project.
# The hidden skill goes beside that .claude/, not in it, where it would load as a project skill.
tmp="$(mktemp -d)"
mkdir -p "$tmp/project/.claude" "$tmp/bin" "$tmp/runs" "$tmp/hidden"
hidden="$tmp/hidden/$skill"
eval_pgid=""

# SIGKILLs each process given and all its descendants, stopping each first so it forks nothing that is missed.
# A claude's tool shells run in process groups of their own, so they are found by parent, not by group.
function kill_tree() {
  local pid child
  for pid in "$@"; do
    kill -STOP "$pid" 2>/dev/null || continue
    for child in $(pgrep -P "$pid"); do kill_tree "$child"; done
    kill -KILL "$pid" 2>/dev/null || true
  done
}

# run_eval runs in a process group of its own, which every claude it starts stays in even once orphaned, so freezing
# and killing that group, with each member's tool shells, leaves nothing of a run alive after this script.
function cleanup() {
  if [[ -n "$eval_pgid" ]]; then
    kill -STOP -- "-$eval_pgid" 2>/dev/null || true
    mapfile -t members < <(pgrep -g "$eval_pgid")
    kill_tree "${members[@]}"
    kill -KILL -- "-$eval_pgid" 2>/dev/null || true
  fi
  if [[ -d "$hidden" && ! -e "$skill_dir" ]]; then
    mv "$hidden" "$skill_dir" && rm -f "$marker"
  fi
  rm -rf "$tmp"
}
trap cleanup EXIT

mkdir -p "$(dirname "$marker")"
echo "$skill $hidden" > "$marker"
mv "$skill_dir" "$hidden"

# Every run gets a PreToolUse hook that blocks each tool call: run_eval decides a run from the first tool the model
# starts to call, which streams before any hook runs, so the score is unchanged, but an eval query never acts.
cat > "$tmp/settings.json" <<'EOF'
{"hooks": {"PreToolUse": [{"matcher": "*", "hooks": [
  {"type": "command", "command": "echo 'skill-trigger-eval blocks every tool' >&2; exit 2"}]}]}}
EOF

# run_eval discards each claude's stderr and scores a failed or hung run as a non-trigger, so a broken login would
# read as a real 0%. This wrapper, first on its PATH, keeps each run's stdout and, when the run ends on its own, its
# exit status: run_eval SIGKILLs a run once it has decided it, so a missing status alone is normal.
# That SIGKILL hits this wrapper, never claude, which would carry on with the query as a real task, so a watcher kills
# claude and its tool shells as soon as the wrapper is gone.
# Each line reaches run_eval before it is recorded: once run_eval has killed the run and closed the pipe, claude's
# last lines before the watcher gets it die on that pipe instead of making a hung run look decided.
cat > "$tmp/bin/claude" <<EOF
#!/usr/bin/env bash
$(declare -f kill_tree)
run="$tmp/runs/\$\$"
: > "\$run.out"
"$real_claude" "\$@" --settings "$tmp/settings.json" > >(while IFS= read -r line; do
  printf '%s\\n' "\$line" || exit 1
  printf '%s\\n' "\$line" >> "\$run.out"
done) &
claude=\$!
(while kill -0 \$\$; do sleep 0.2; done; kill_tree "\$claude") > /dev/null 2>&1 &
watcher=\$!
wait "\$claude" && status=0 || status=\$?
kill -KILL "\$watcher"
echo "\$status" > "\$run.status"
EOF
chmod +x "$tmp/bin/claude"

# One worker: run_eval's parallel workers each write their own copy of the candidate into the one project, so a run
# sees several identical commands, mostly takes another's, and scores a miss; ten workers scored 10 of 21, one 20.
args=(-m scripts.run_eval --eval-set "$(cd "$(dirname "$eval_set")" && pwd -P)/$skill.json" --skill-path "$hidden"
  --runs-per-query 3 --timeout 120 --num-workers 1 --model "$model")
[[ -n "$description" ]] && args+=(--description "$description")

# In the background, so a signal reaches the trap now rather than once run_eval returns, and with job control on, so
# it leads a process group of its own for cleanup to kill. Stdin is /dev/null, since a background group reading the
# terminal would stop.
set -m
(cd "$tmp/project" && exec env -u CLAUDECODE PATH="$tmp/bin:$PATH" PYTHONPATH="$creator" "$python" "${args[@]}") \
  < /dev/null > "$tmp/result.json" 2> "$tmp/stderr" &
eval_pgid=$!
set +m
wait "$eval_pgid" && rc=0 || rc=$?
cat "$tmp/stderr" >&2
[[ "$rc" -eq 0 ]] || die "run_eval exited $rc"

# A run failed if it exited non-zero, or was killed before it printed a single stream event: a hang or a timeout.
failed=0
total=0
for out in "$tmp"/runs/*.out; do
  [[ -e "$out" ]] || continue
  total=$((total + 1))
  status_file="${out%.out}.status"
  if [[ -e "$status_file" ]]; then
    [[ "$(cat "$status_file")" == 0 ]] || failed=$((failed + 1))
  elif ! grep -q '"type": *"stream_event"' "$out"; then
    failed=$((failed + 1))
  fi
done
grep -q 'query failed' "$tmp/stderr" && failed=$((failed > 0 ? failed : 1))
[[ "$failed" -eq 0 ]] || die "$failed of $total claude runs failed; no score reported"

cat "$tmp/result.json"
