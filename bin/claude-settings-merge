#!/usr/bin/env bash
#
# Merge the dotfiles-owned entries into a machine-local Claude Code settings.json, leaving everything else as is.
#
# Usage: claude-settings-merge hooks|hardening <settings-file>
#   hooks      Register ~/.claude/hooks/work-context.sh for PreToolUse and SessionStart.
#   hardening  Add the credential, rc-file and issue-marker deny rules, and load AGENTS.md beside CLAUDE.md.
#
# Exit 0 on success; 1 when jq is missing, the guard script is missing (hooks only) or the file isn't valid JSON,
# with the file untouched; 2 on bad usage.

set -euo pipefail

function usage() {
  echo "Usage: $(basename "$0") hooks|hardening <settings-file>" >&2
  exit 2
}

# Owned entries are found by their command, then removed and re-appended on every run, so a change to the
# canonical entry reaches machines that already ran this. A foreign hook sharing a group with ours stays.
# shellcheck disable=SC2016 # $vars are jq's, not the shell's
hooks_filter='
  def owned: (.command // "") | contains("work-context.sh");
  def merge(event; entry):
    .hooks[event] = ([(.hooks[event] // [])[]
      | .hooks = [(.hooks // [])[] | select(owned | not)]
      | select(.hooks | length > 0)] + [entry]);
  merge("PreToolUse"; {
    matcher: "Bash|Monitor|Write|Edit|MultiEdit|NotebookEdit",
    hooks: [{type: "command", command: "/bin/bash ~/.claude/hooks/work-context.sh pre-tool-use",
             timeout: 10, onFailure: "block"}]
  })
  | merge("SessionStart"; {
    hooks: [{type: "command", command: "/bin/bash ~/.claude/hooks/work-context.sh session-start", timeout: 10}]
  })
'

# unique also sorts, so the deny list stays in the order bin/sort-claude-settings would give it.
# The marker rules are anchored at ~/ because the marker sits above the repo, beyond a bare or **/ path's reach.
# instructionFiles is set only when unset, so a deliberate local choice survives.
hardening_filter='
  .permissions.deny = (((.permissions.deny // []) + [
    "Read(~/.ssh/id_*)", "Read(~/.ssh/keys/**)", "Read(~/.aws/credentials)", "Read(~/.kube/config)",
    "Read(~/.git-credentials)", "Read(~/.gitconfig_credentials)", "Read(~/.gnupg/**)", "Read(~/.config/gh/hosts.yml)",
    "Edit(~/.zshrc)", "Edit(~/.bashrc)", "Edit(~/.bash_profile)", "Edit(~/.zprofile)", "Edit(~/.profile)",
    "Edit(~/**/.claude-files-issues)", "Bash(touch *.claude-files-issues*)"
  ]) | unique)
  | .pluginConfigs["cc-plugin-agents-md@builtin"].options.instructionFiles //= "claude-md-and-agents-md"
'

[[ $# -eq 2 ]] || usage
settings="$2"
case "$1" in
  hooks) filter="$hooks_filter" ;;
  hardening) filter="$hardening_filter" ;;
  *) usage ;;
esac

# A hook pointing at nothing either blocks every tool call (onFailure: block) or silently guards nothing.
# hardening registers no hook, so it doesn't need the guard.
guard="$HOME/.claude/hooks/work-context.sh"
if [[ "$1" == hooks && ! -r "$guard" ]]; then
  echo "$guard not found; run dotfiles first. $settings left untouched." >&2
  exit 1
fi

if ! type -P jq >/dev/null; then
  echo "jq not found; $settings left untouched." >&2
  exit 1
fi

[[ -s "$settings" ]] || echo '{}' > "$settings"

if jq "$filter" "$settings" > "$settings.tmp"; then
  mv "$settings.tmp" "$settings"
else
  rm -f "$settings.tmp"
  echo "Couldn't update $settings; is it valid JSON?" >&2
  exit 1
fi
