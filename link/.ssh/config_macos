Include ~/.ssh/config_private

Host *
  # 1Password SSH Agent
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

  # Trust a new host on first connect, but refuse one whose key has changed
  StrictHostKeyChecking accept-new

  # No agent forwarding by default: add ForwardAgent yes under the one Host that needs it

  # macOS Keychain integration
  UseKeychain yes
  AddKeysToAgent yes
