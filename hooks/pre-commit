#!/usr/bin/env bash
#
# Pre-commit hook for dotfiles repo.
#
# Uses mapfile (bash 4+). Re-execs under brew bash on macOS where
# /usr/bin/bash is still 3.2.

if ((BASH_VERSINFO[0] < 4)); then
  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$candidate" ]] && exec "$candidate" "$0" "$@"
  done
  echo "ERROR: pre-commit hook needs bash 4+; current: $BASH_VERSION" >&2
  echo "Install brew bash: brew install bash" >&2
  exit 1
fi

set -euo pipefail

# Sync Claude Code deny rules when git-secret paths change.
if git diff --cached --name-only | grep -q '^\.gitsecret/paths/mapping\.cfg$'; then
  bin/sync-claude-deny
  git add .claude/settings.json
fi

# Sort Claude Code settings when staged.
if git diff --cached --name-only | grep -q '^\.claude/settings\.json$'; then
  bin/sort-claude-settings
  git add .claude/settings.json
fi

# Enforce repo-wide: every tracked md must opt in to doctoc (markers) or opt out (SKIP).
# Catches violations in unrelated files too — fix-first, never silent-default.
# claude/ and .claude/ are exempt: a ToC is a navigation aid for humans browsing on GitHub,
# and nothing under either is read that way — both are context loaded by an agent.
mapfile -d '' -t all_md < <(git ls-files -z -- '*.md' ':(exclude)claude/' ':(exclude).claude/')
missing=()
for f in "${all_md[@]}"; do
  [[ -f "$f" ]] || continue
  grep -qE '<!-- (START doctoc|DOCTOC SKIP)' "$f" 2>/dev/null || missing+=("$f")
done
if (( ${#missing[@]} > 0 )); then
  echo "ERROR: these tracked markdown files lack both doctoc markers and '<!-- DOCTOC SKIP -->':" >&2
  printf '  %s\n' "${missing[@]}" >&2
  echo "Add doctoc markers (for a ToC) or '<!-- DOCTOC SKIP -->' (to opt out) at the top." >&2
  exit 1
fi

# Update ToCs and lint markdown in staged *.md files.
# -z throughout: git C-quotes any path with a non-ASCII or control character, and
# the quoted form matches nothing on disk, so the file would be skipped in silence.
mapfile -d '' -t md_files < <(git diff --cached -z --name-only --diff-filter=ACMR -- '*.md')
mapfile -d '' -t toc_files < <(git diff --cached -z --name-only --diff-filter=ACMR -- '*.md' ':(exclude)claude/' ':(exclude).claude/')
if (( ${#toc_files[@]} > 0 )) && command -v doctoc >/dev/null 2>&1; then
  doctoc --github --notitle "${toc_files[@]}" >/dev/null
  git add "${toc_files[@]}"
fi
if (( ${#md_files[@]} > 0 )) && command -v markdownlint-cli2 >/dev/null 2>&1; then
  markdownlint-cli2 --fix "${md_files[@]}" >/dev/null
  git add "${md_files[@]}"
fi

# Markdown size limits. The caps, what counts toward them and which breaches are
# advisory rather than fatal all live in bin/check-md-limits and the rule it cites;
# restating them here only gives them somewhere to drift apart.
if (( ${#md_files[@]} > 0 )); then
  bin/check-md-limits -- "${md_files[@]}"
fi

# Warn when a commit adds or removes a user-facing alias, function or bin/ script without
# touching tips/. Narrow on purpose: matching *any* source/ edit fires on refactors that
# have no user-facing surface, and a warning nobody reads is worse than none.
# Advisory only — plenty of definitions are internal helpers that want no tip.
defs=$(git diff --cached --unified=0 -- source bin \
  | grep -cE '^[+-][[:space:]]*(alias [A-Za-z0-9_.-]+=|function [A-Za-z0-9_-]+|[A-Za-z0-9_-]+\(\))' || true)
bin_files=$(git diff --cached --name-status -- bin | grep -cE '^[AD]' || true)
tips_staged=$(git diff --cached --name-only -- tips TIPS.md | grep -c . || true)

if (( defs > 0 || bin_files > 0 )) && (( tips_staged == 0 )); then
  echo "NOTE: this commit changes $defs alias/function definition line(s) and $bin_files bin/ script(s)," >&2
  echo "      but stages nothing under tips/ or TIPS.md." >&2
  echo "      If any of it is user-facing, add or update its tip in this commit (see the writing-tips skill)." >&2
  echo "      Internal helpers need no tip — this is advisory and does not block the commit." >&2
fi
