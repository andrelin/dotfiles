{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "One grouped PR of every non-major update, left for review. Majors come as their own PRs.",
  "extends": ["github>andrelin/dotfiles//renovate/recommended"],
  "packageRules": [
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    }
  ]
}
